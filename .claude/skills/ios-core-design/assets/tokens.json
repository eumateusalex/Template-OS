  "material": {
    "calibrated": true,
    "note": "Ingredientes do vidro que não mudam com o tema. Clear NÃO adapta de propósito (spec). Anatomia e justificativas: references/materials.md. Regra: vidro não amostra vidro — nunca aninhar.",
    "blur": 20,
    "saturate": 1.8,
    "clearBg": "rgba(255, 255, 255, 0.12)",
    "dim": "rgba(0, 0, 0, 0.35)",
    "dataGlass": {
      "attribute": "data-glass",
      "values": ["regular", "frosted", "solid"],
      "note": "Tradução web do slider de intensidade do iOS 27. Sem atributo = regular; solid = extremo opaco (mesmo destino dos fallbacks automáticos)."
    }
  },
